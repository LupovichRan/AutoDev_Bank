#!/usr/bin/env bash
# AutoDev Bank in-house developer entry point. Usage: ./dev <command>
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
cd "$ROOT"
export DATABASE_URL="${DATABASE_URL:-postgres://postgres@localhost:55432/bank?sslmode=disable}"
export PATH="$PATH:$(go env GOPATH 2>/dev/null)/bin"

usage() {
  cat <<USAGE
usage: ./dev <command>
  demo                         see the product: pg start, migrate, seed, refresh, build web,
                               serve on http://localhost:8080 with demo sign-in (dev only)
  pg start|stop|reset|status   local PostgreSQL 16 under .pgdata (no Docker)
  migrate                      apply migrations/*.sql
  seed [--force]               load demo principals and accounts (localhost origins only unless --force)
  refresh                      fetch live open data into the cache
  test                         go test ./...   (integration tests use DATABASE_URL)
  run                          build web (if npm present) and serve on \$BANK_ADDR (default :8080)
  web                          vite dev server with /api proxy
  e2e                          Playwright end-to-end suite (starts its own server)
  ci                           vet + race tests + web build/check/test
USAGE
}

build_web() {
  if [ -f web/package.json ] && command -v npm >/dev/null; then
    [ -d web/node_modules ] || npm --prefix web ci
    npm --prefix web run build
  fi
}

case "${1:-}" in
  demo)
    # Local demo only: BANK_DEV_TEST_LOGIN=1 adds passkey-free "Demo sign-in"
    # buttons for the seeded users. Never use this outside your machine.
    # Use a PostgreSQL already reachable at DATABASE_URL, else start the local one.
    if ! psql "$DATABASE_URL" -qtAc 'select 1' >/dev/null 2>&1; then
      tools/pg.sh start >/dev/null
    fi
    go run ./cmd/bank migrate
    BANK_ORIGIN=http://localhost:8080 go run ./cmd/bank seed
    go run ./cmd/bank opendata-refresh || echo "dev: open-data refresh failed; recorded fixtures will be served" >&2
    build_web
    # The web build overwrites the tracked web/dist/index.html placeholder;
    # put it back when the server stops.
    trap 'git checkout -- web/dist/index.html 2>/dev/null || true' EXIT
    echo "dev: open http://localhost:8080 and use a Demo sign-in button (Ctrl-C stops the server)" >&2
    BANK_DEV_TEST_LOGIN=1 BANK_ORIGIN=http://localhost:8080 BANK_ADDR=:8080 go run ./cmd/bank serve ;;
  pg) shift; tools/pg.sh "$@" ;;
  migrate) go run ./cmd/bank migrate ;;
  seed) shift; go run ./cmd/bank seed "$@" ;;
  refresh) go run ./cmd/bank opendata-refresh ;;
  test) shift; go test ./... "$@" ;;
  run)
    build_web
    go run ./cmd/bank serve ;;
  web) npm --prefix web run dev ;;
  e2e) shift; tools/e2e.sh "$@" ;;
  ci)
    go vet ./...
    go test -race ./...
    if [ -f web/package.json ]; then
      npm --prefix web ci
      npm --prefix web run build
      npm --prefix web run check
      npm --prefix web test
    fi ;;
  ""|-h|--help|help) usage ;;
  *) echo "unknown command: $1" >&2; usage; exit 2 ;;
esac
