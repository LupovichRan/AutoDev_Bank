DATABASE_URL=postgres://postgres@localhost:55432/bank?sslmode=disable
BANK_ADDR=:8080
BANK_ORIGIN=http://localhost:8080
# Nothing loads this file automatically: export the variables yourself, e.g.
#   set -a; . ./.env; set +a
# Hex-encoded 32-byte Ed25519 seed that signs daily audit roots (openssl rand -hex 32).
# Required unless BANK_ORIGIN is localhost/loopback; then, when empty, an ephemeral
# key is generated (only its public key and fingerprint are logged) and lost on restart.
BANK_AUDIT_SIGNING_KEY=
# Optional: Enable Banking restricted production (your own accounts). Leave empty to disable.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
# or a path to the PEM file:
ENABLE_BANKING_PRIVATE_KEY_FILE=
ENABLE_BANKING_ACCOUNT_UIDS=
