DATABASE_URL=postgres://postgres@localhost:55432/bank?sslmode=disable
BANK_ADDR=:8080
BANK_ORIGIN=http://localhost:8080
# hex-encoded 32-byte Ed25519 seed used to sign daily audit roots; generated and logged when empty
BANK_AUDIT_SIGNING_KEY=
# Optional: Enable Banking restricted production (your own accounts). Leave empty to disable.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
# or a path to the PEM file:
ENABLE_BANKING_PRIVATE_KEY_FILE=
ENABLE_BANKING_ACCOUNT_UIDS=
